---
import { services } from '../data/services';
import { appUrl } from '../data/site';

interface Props {
  /** Marks the active top-level section for subtle highlighting. */
  active?: 'services' | 'about' | null;
}

const { active = null } = Astro.props;
---

<nav>
  <a class="brand" href="/">
    <img class="mark" src="/autopoiesis-logo.svg" width="40" height="40" alt="" />
    <div class="wm">autopoiesis</div>
  </a>

  <div class="nav-right">
    <!-- Services dropdown -->
    <div class="nav-dropdown" data-dropdown data-open="false">
      <button
        type="button"
        class:list={['nav-link', 'dd-trigger', { 'is-active': active === 'services' }]}
        aria-controls="services-menu"
        aria-expanded="false"
      >
        <span>services</span>
        <span class="dd-caret" aria-hidden="true"></span>
      </button>

      <div class="dd-menu" id="services-menu">
        {services.map((s) => (
          <a
            class:list={['dd-item', { 'dd-product-start': s.slug === 'reinforcement-learning' }]}
            href={`/services/${s.slug}/`}
            aria-current={Astro.url.pathname.replace(/\/$/, '') === `/services/${s.slug}` ? 'page' : undefined}
          >
            <span class="dd-num">{s.num}</span>
            <span class="dd-body">
              <span class="dd-title">{s.navTitle}</span>
              {s.status === 'in-development' && <span class="dd-status">{s.badge}</span>}
            </span>
            <span class="dd-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
        <div class="dd-divider"></div>
        <a class="dd-all" href="/services/">
          All services
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <a
      class:list={['nav-link', { 'is-active': active === 'about' }]}
      href="/about/"
    ><span>about</span></a>

    <a class="login login--ghost" href="/#contact">Get in touch</a>
    <a class="login login--app" href={appUrl} rel="noopener">Log in</a>
  </div>
</nav>
