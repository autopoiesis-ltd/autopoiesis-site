---

<footer>
  <a class="brand" href="/">
    <div class="mark" data-helix="24"></div>
    <div class="wm" data-scramble>autopoiesis</div>
  </a>
  <div class="foot-right">
    <a
      class="foot-link"
      href="https://www.linkedin.com/company/autopoiesis-ltd/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Autopoiesis on LinkedIn"
    >
      <svg class="foot-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
      </svg>
      <span data-scramble>linkedin</span>
    </a>
    <div class="legal" data-scramble>© MMXXVI · in genesis</div>
  </div>
</footer>

<style>
  .foot-right {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .foot-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--paper-muted);
    text-decoration: none;
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    transition: color 200ms ease;
  }
  .foot-link:hover { color: var(--paper); }
  .foot-icon {
    width: 14px;
    height: 14px;
    flex: none;
  }
</style>
