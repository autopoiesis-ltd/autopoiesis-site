---
import Base from '../layouts/Base.astro';
import { services } from '../data/services';
import { principles } from '../data/principles';
---

<Base
  title="Autopoiesis — Security services"
  description="Self-adaptive security for agentic systems."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <canvas id="hero-canvas" class="hero-bg" data-drift="true" aria-hidden="true"></canvas>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="eyebrow" data-scramble data-scramble-now>AI security research lab</div>
      <h1 class="hero-headline" data-scramble data-scramble-now>Your agents will be attacked.</h1>
      <p class="hero-sub" data-scramble data-scramble-now>Adversarial testing, secure-by-design engineering, and autonomous security products for agent-native security teams and products.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/services/">Explore services <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- ============ THESIS / PRINCIPLES ============ -->
  <section class="thesis">
    <div class="eyebrow" data-scramble>Our thesis</div>
    <h2 data-scramble>Security as a living system.</h2>
    <p class="thesis-lead" data-scramble>
      <em>Autopoiesis</em> &mdash; from the Greek <em>autos</em> (self) and
      <em>poiesis</em> (creation) &mdash; is how biologists Maturana and Varela
      defined life itself: a system that continuously produces and repairs the
      components that keep it alive, inside a boundary it makes for itself.
      We believe cybersecurity has to work the same way.
    </p>
    <div class="principle-grid">
      {principles.map((p) => (
        <div class="principle">
          <div class="principle-head">
            <span class="p-num" data-scramble>{p.num}</span>
            <span class="p-bio" data-scramble>{p.bio}</span>
          </div>
          <h3 data-scramble>{p.term}</h3>
          <p data-scramble>{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="services" id="services">
    <div class="eyebrow" data-scramble>Our service offerings</div>
    <h2 data-scramble>Securing autonomous systems.</h2>
    <p class="services-lead" data-scramble>
      We build security products and work directly with the businesses shipping
      agentic systems &mdash; from hands-on red teaming and secure engineering to
      deployable capability your own cybersecurity team can run at scale.
    </p>
    <div class="service-grid">
      {services.map((s) => (
        <a class="service" href={`/services/${s.slug}/`}>
          <div class="service-top">
            <div class="num" data-scramble>{s.num}</div>
            {s.status === 'in-development' && <span class="badge">{s.badge}</span>}
          </div>
          <h3 data-scramble>{s.title}</h3>
          <p data-scramble>{s.summary}</p>
          <span class="service-more" aria-hidden="true">Learn more &rarr;</span>
        </a>
      ))}

      <a class="service service--research" href="mailto:info@autopoiesis.uk?subject=Research%20%26%20what%27s%20next">
        <div class="service-top">
          <div class="num research-label">
            <span class="research-dot" aria-hidden="true"></span>
            <span data-scramble>Always researching&hellip;</span>
          </div>
        </div>
        <h3 data-scramble>More to come</h3>
        <p data-scramble>New attacks and defences for agentic systems ship as the frontier moves.</p>
        <span class="service-more" aria-hidden="true">Shape what&rsquo;s next &rarr;</span>
      </a>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="contact">
    <h2 data-scramble>Get in touch!</h2>
    <p data-scramble>Book a call with us, or send an email &mdash; whatever suits you.</p>
    <div class="contact-ctas">
      <button type="button" class="book" data-calendly>
        <span data-scramble>Book a time</span>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </button>
      <a class="mail" href="mailto:info@autopoiesis.uk">
        <span data-scramble>info@autopoiesis.uk</span>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Calendly popup assets -->
  <link
    rel="stylesheet"
    href="https://assets.calendly.com/assets/external/widget.css"
  />
  <script
    src="https://assets.calendly.com/assets/external/widget.js"
    is:inline
    async
  ></script>
  <script is:inline>
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-calendly]');
      if (!trigger) return;
      e.preventDefault();
      if (window.Calendly) {
        window.Calendly.initPopupWidget({
          url: 'https://calendly.com/mlvb-autopoiesis',
        });
      } else {
        window.open('https://calendly.com/mlvb-autopoiesis', '_blank', 'noopener');
      }
    });
  </script>
</Base>

<style>
  /* ==================== HERO ==================== */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 140px 24px 96px;
    overflow: hidden;
    background: radial-gradient(ellipse 70% 50% at 50% 50%, #181A1D 0%, var(--ink) 78%);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.62;
    pointer-events: none;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 62% 56% at 50% 50%,
      rgba(11, 12, 13, 0.86) 0%,
      rgba(11, 12, 13, 0.4) 46%,
      transparent 76%
    );
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 860px;
  }
  .hero-content .eyebrow { margin-bottom: 26px; }
  .hero-headline {
    font-size: clamp(38px, 7vw, 86px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 500;
    margin-bottom: 28px;
    text-wrap: balance;
  }
  .hero-sub {
    color: var(--paper-dim);
    font-size: clamp(14px, 1.7vw, 17px);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 40px;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 15px 26px;
    border-radius: 3px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    transition: transform 200ms ease, background 200ms ease,
      border-color 200ms ease, color 200ms ease;
  }
  .btn-primary {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--paper);
  }
  .btn-primary:hover { transform: translateY(-2px); background: #fff; }
  .btn-ghost {
    background: transparent;
    color: var(--paper);
    border: 1px solid var(--line);
  }
  .btn-ghost:hover { border-color: var(--paper-muted); background: var(--ink-lift); }

  @media (max-width: 600px) {
    .hero { padding: 116px 20px 72px; min-height: 86vh; }
    .hero-headline { letter-spacing: -0.03em; }
    .btn { flex: 1 1 auto; justify-content: center; }
  }

  /* ==================== THESIS ==================== */
  .thesis {
    max-width: 1180px;
    margin: 0 auto;
    padding: 80px 40px;
    border-top: 1px solid var(--line);
  }
  .thesis .eyebrow { margin-bottom: 20px; }
  .thesis h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.02em;
    font-weight: 500;
    margin-bottom: 24px;
    max-width: 640px;
  }
  .thesis-lead {
    color: var(--paper-dim);
    font-size: 15px;
    line-height: 1.85;
    max-width: 680px;
    margin-bottom: 56px;
  }
  .thesis-lead em { color: var(--paper); font-style: italic; }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .principle {
    background: var(--ink);
    padding: 34px 30px 38px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .principle-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .principle .p-num {
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--rec);
    font-weight: 500;
  }
  .principle .p-bio {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-faint);
  }
  .principle h3 {
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .principle p {
    color: var(--paper-muted);
    font-size: 13px;
    line-height: 1.7;
  }
  @media (max-width: 820px) {
    .principle-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .thesis { padding: 60px 24px; }
  }

  /* ==================== SERVICES ==================== */
  .services {
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 40px;
    border-top: 1px solid var(--line);
  }
  .services .eyebrow { margin-bottom: 20px; }
  .services h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.015em;
    font-weight: 500;
    margin-bottom: 24px;
    max-width: 640px;
  }
  .services-lead {
    color: var(--paper-dim);
    font-size: 15px;
    line-height: 1.8;
    max-width: 600px;
    margin-bottom: 48px;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .service {
    background: var(--ink);
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    transition: background 240ms ease;
  }
  .service:hover { background: var(--ink-lift); }
  .service-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .service .num {
    font-size: 10px;
    letter-spacing: 0.28em;
    color: var(--rec);
    font-weight: 500;
  }
  .service h3 {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }
  .service p {
    color: var(--paper-muted);
    font-size: 13px;
    line-height: 1.7;
  }
  .service-more {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper-faint);
    transition: color 220ms ease, transform 220ms ease;
  }
  .service:hover .service-more {
    color: var(--rec);
    transform: translateX(3px);
  }

  /* research / "more to come" teaser card */
  .service--research {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0,
        transparent 9px,
        rgba(247, 243, 233, 0.012) 9px,
        rgba(247, 243, 233, 0.012) 10px
      ),
      var(--ink);
  }
  .research-label {
    display: inline-flex;
    align-items: center;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .research-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rec);
    margin-right: 8px;
    animation: research-pulse 1.8s ease-in-out infinite;
  }
  @keyframes research-pulse {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50%      { opacity: 1; transform: scale(1); }
  }

  /* ==================== CONTACT ==================== */
  .contact {
    text-align: center;
    padding: 76px 24px 96px;
    border-top: 1px solid var(--line);
  }
  .contact h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.015em;
    font-weight: 500;
    margin-bottom: 24px;
  }
  .contact p {
    color: var(--paper-muted);
    max-width: 500px;
    margin: 0 auto 40px;
    font-size: 13px;
    line-height: 1.7;
  }
  .contact-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
  .contact .book {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    border: 1px solid var(--paper);
    border-radius: 3px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: transform 200ms ease, background 200ms ease;
  }
  .contact .book:hover { transform: translateY(-2px); background: #fff; }
  .contact .book .arrow {
    opacity: 0.7;
    transition: transform 200ms ease;
  }
  .contact .book:hover .arrow { transform: translateX(3px); }
  .contact a.mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--paper);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.1em;
    transition: border-color 200ms ease, background 200ms ease;
  }
  .contact a.mail:hover {
    border-color: var(--paper-muted);
    background: var(--ink-lift);
  }
  .contact a.mail .arrow {
    opacity: 0.6;
    transition: transform 200ms ease;
  }
  .contact a.mail:hover .arrow { transform: translateX(3px); }

  @media (max-width: 720px) {
    .services { padding: 60px 24px; }
    .service-grid { grid-template-columns: 1fr; }
    .service { padding: 32px 28px; }
  }
</style>
