---
import Base from '../layouts/Base.astro';
import FieldScene from '../components/FieldScene.astro';
import { services } from '../data/services';
const capabilities = [
  { icon: 'adversarial-testing', title: 'Red teaming and adversarial testing', body: 'Find real-world failures before they’re exploited.', href: '/services/red-teaming/' },
  { icon: 'secure-engineering', title: 'Secure agentic systems', body: 'Build AI systems that are resilient by design.', href: '/services/secure-agent-build/' },
  { icon: 'autonomous-security', title: 'Autonomous security', body: 'Continuously adaptive security for an evolving world.', href: '/services/cyber-reasoning-systems/' },
  { icon: 'secure-research', title: 'Secure AI research platforms', body: 'Run frontier AI research inside environments built to contain it.', href: '/services/ai-research-platform/' },
];
---

<Base
  title="Autopoiesis — Security services"
  description="Self-adaptive security for agentic systems."
>
  <FieldScene />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-top">
      <!-- live readings from the simulation behind the page -->
      <dl class="hud" aria-hidden="true">
        <div><dt>Generation</dt><dd data-field-stat="steps">0000000</dd></div>
        <div><dt>Feed rate</dt><dd data-field-stat="feed">0.0360</dd></div>
        <div><dt>Decay rate</dt><dd data-field-stat="kill">0.0610</dd></div>
        <div><dt>Nucleation sites</dt><dd data-field-stat="seeds">00</dd></div>
        <div><dt>Wounds inflicted</dt><dd data-field-stat="wounds">000</dd></div>
        <div><dt>Renderer</dt><dd data-field-stat="renderer">&mdash;</dd></div>
      </dl>
    </div>
    <h1 class="hero-headline">Autonomy <br class="hero-break-narrow" />needs<br />an immune <br class="hero-break-narrow" />system.</h1>
    <div class="hero-foot">
      <div>
        <p class="hero-sub">Adversarial testing, secure-by-design engineering, and autonomous security products.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/services/">Explore services <span aria-hidden="true">&rarr;</span></a>
          <a class="btn btn-ghost" href="/#contact">Get in touch</a>
        </div>
      </div>
      <p class="hero-hint" aria-hidden="true">
        <span class="hint-dot"></span>
        <span>A living system, not a recording. Move across it to wound it &mdash; it grows back.</span>
      </p>
    </div>
  </section>

  <!-- ============ THESIS / PRINCIPLES ============ -->
  <section class="thesis">
    <div class="eyebrow">Our thesis</div>
    <h2>Security continuously evolves.</h2>
    <p class="thesis-lead">
      <em>Autopoiesis</em> &mdash; from the Greek <em>autos</em> (self) and
      <em>poiesis</em> (creation) &mdash; is how biologists Maturana and Varela
      defined life itself: a system that continuously produces and repairs the
      components that keep it alive, inside a boundary it makes for itself.
      We believe cybersecurity has to work the same way - as adversaries find new vulnerabilities, defenses must continuously adapt.
      We design every system formally, using applied category theory and formal grammars, so that how its parts compose is specified rather than assumed.
    </p>
    <div class="capability-grid">
      {capabilities.map(capability => <a class="capability" href={capability.href}>
        <span class="capability-icon"><img src={`/icons/${capability.icon}.svg`} width="48" height="48" alt="" /></span>
        <span><strong>{capability.title}</strong><span class="capability-body">{capability.body}</span></span>
        <span class="capability-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="services" id="services">
    <div class="eyebrow">Our service offerings</div>
    <h2>Securing autonomous systems.</h2>
    <p class="services-lead">
      We build security products and work directly with the businesses shipping
      agentic systems &mdash; from hands-on red teaming and secure engineering to
      deployable autonomous capability your own cybersecurity team can run at scale.
    </p>
    <div class="service-grid">
      {services.map((s) => (
        <a class="service" href={`/services/${s.slug}/`}>
          <div class="service-top">
            <div class="num">{s.num}</div>
            {s.status === 'in-development' && <span class="badge">{s.badge}</span>}
          </div>
          <h3>{s.title}</h3>
          <p>{s.summary}</p>
          <span class="service-more" aria-hidden="true">Learn more &rarr;</span>
        </a>
      ))}

      <a class="service service--research" href="mailto:info@autopoiesis.uk?subject=Research%20%26%20what%27s%20next">
        <div class="service-top">
          <div class="num research-label">
            <span class="research-dot" aria-hidden="true"></span>
            <span>Always researching&hellip;</span>
          </div>
        </div>
        <h3>More to come</h3>
        <p>New attacks and defences for agentic systems ship as the frontier moves.</p>
        <span class="service-more" aria-hidden="true">Shape what&rsquo;s next &rarr;</span>
      </a>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="contact" id="contact">
    <h2>Get in touch!</h2>
    <p>Book a call with us, or send an email &mdash; whatever suits you.</p>
    <div class="contact-ctas">
      <button type="button" class="book" data-calendly>
        <span>Book a time</span>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </button>
      <a class="mail" href="mailto:info@autopoiesis.uk">
        <span>info@autopoiesis.uk</span>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Calendly popup assets -->
  <link
    rel="stylesheet"
    href="https://assets.calendly.com/assets/external/widget.css"
  />
  <script
    src="https://assets.calendly.com/assets/external/widget.js"
    is:inline
    async
  ></script>
  <script is:inline>
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-calendly]');
      if (!trigger) return;
      e.preventDefault();
      if (window.Calendly) {
        window.Calendly.initPopupWidget({
          url: 'https://calendly.com/mlvb-autopoiesis',
        });
      } else {
        window.open('https://calendly.com/mlvb-autopoiesis', '_blank', 'noopener');
      }
    });
  </script>
  <script>
    import { revealOnScroll } from '../scripts/scroll-reveal.js';
    revealOnScroll('.thesis > .eyebrow, .thesis > h2, .thesis-lead, .capability, .services > .eyebrow, .services > h2, .services-lead, .service, .contact > *');

    // Each service card carries a soft light that follows the pointer across it.
    document.querySelectorAll<HTMLElement>('.service').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - box.left}px`);
        card.style.setProperty('--my', `${event.clientY - box.top}px`);
      });
    });
  </script>
</Base>

<style>
  .capability-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-bottom: 48px; }
  .capability { display: flex; align-items: flex-start; gap: 18px; padding: 24px 20px; color: var(--paper); text-decoration: none; border: 1px solid var(--line); background: transparent; transition: border-color .2s, background .2s; }
  .capability:hover { border-color: var(--plasma-tint); background: var(--ink-lift); }
  .capability-icon { display: grid; place-items: center; width: 62px; height: 62px; flex: none; border: 1px solid var(--line); }
  .capability strong { display: block; font-size: 16px; font-weight: 500; margin: 5px 0 10px; }
  .capability-body { display: block; color: var(--paper-dim); font-size: 13px; line-height: 1.6; }
  .capability-arrow { margin-left: auto; color: var(--paper-dim); }
  @media (max-width: 1000px) { .capability-grid { grid-template-columns: 1fr; } }
  /* The hero is transparent: the fixed field behind the page shows through it. */
  .hero { position: relative; min-height: max(100svh, 640px); display: flex; flex-direction: column; justify-content: space-between; gap: 40px; padding: 124px 4.6vw 44px; border-bottom: 1px solid var(--line); }
  /* keeps the headline and copy legible over the brightest growth */
  .hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, rgba(20, 18, 16, .78) 0%, rgba(20, 18, 16, .35) 38%, rgba(20, 18, 16, 0) 68%); }
  .hero > * { position: relative; }
  .hero-top { display: flex; justify-content: flex-end; align-items: flex-start; gap: 32px; }
  .hud { display: grid; grid-template-columns: auto auto; column-gap: 28px; row-gap: 7px; padding: 14px 16px; background: rgba(20, 18, 16, .72); border: 1px solid var(--line); font-family: var(--font-mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }
  .hud div { display: contents; }
  .hud dt { color: var(--paper-faint); }
  .hud dd { color: var(--paper); text-align: right; font-variant-numeric: tabular-nums; }
  .hero-headline { font-size: clamp(52px, 10.2vw, 210px); line-height: .86; letter-spacing: -.045em; font-weight: 500; margin-top: auto; }
  .hero-break-narrow { display: none; }
  .hero-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap; }
  .hero-sub { color: var(--paper-dim); font-size: 19px; line-height: 1.5; max-width: 520px; margin-bottom: 28px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-hint { display: flex; align-items: center; gap: 12px; max-width: 340px; font-family: var(--font-mono); font-size: 10px; line-height: 1.7; letter-spacing: .16em; text-transform: uppercase; color: var(--paper-muted); }
  .hint-dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--rec); animation: hint-pulse 1.8s ease-in-out infinite; }
  @keyframes hint-pulse { 0%, 100% { opacity: .25; transform: scale(.85); } 50% { opacity: 1; transform: scale(1); } }
  .btn { display: inline-flex; align-items: center; justify-content: space-between; gap: 18px; height: 52px; padding: 0 26px; border-radius: 0; font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; font-weight: 500; transition: background .2s, border-color .2s; }
  .btn-primary { background: var(--paper); color: var(--ink); border: 1px solid var(--paper); }
  .btn-primary:hover { background: var(--plasma-tint); border-color: var(--plasma-tint); }
  .btn-ghost { color: var(--paper); border: 1px solid rgba(244, 240, 232, 0.35); background: rgba(20, 18, 16, .55); }
  .btn-ghost:hover { border-color: var(--paper); }
  @media (max-width: 900px) {
    .hero { padding: 116px 6vw 36px; }
    .hud { display: none; }
    .hero-headline { font-size: clamp(48px, 14.5vw, 120px); }
    .hero-break-narrow { display: inline; }
    .hero-sub { font-size: 16px; }
  }

  /* ==================== THESIS ==================== */
  .thesis {
    max-width: 1440px;
    margin: 0 auto;
    padding: 64px 5vw;
    border-top: 1px solid var(--line);
  }
  .thesis .eyebrow { margin-bottom: 20px; }
  .thesis h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.02em;
    font-weight: 500;
    margin-bottom: 24px;
    max-width: 640px;
  }
  .thesis-lead {
    color: var(--paper-dim);
    font-size: 15px;
    line-height: 1.85;
    max-width: 680px;
    margin-bottom: 56px;
  }
  .thesis-lead em { color: var(--paper); font-style: italic; }
  @media (max-width: 720px) {
    .thesis { padding: 60px 24px; }
  }

  /* ==================== SERVICES ==================== */
  .services {
    max-width: 1440px;
    margin: 0 auto;
    padding: 64px 5vw;
    border-top: 1px solid var(--line);
  }
  .services .eyebrow { margin-bottom: 20px; }
  .services h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.015em;
    font-weight: 500;
    margin-bottom: 24px;
    max-width: 640px;
  }
  .services-lead {
    color: var(--paper-dim);
    font-size: 15px;
    line-height: 1.8;
    max-width: 600px;
    margin-bottom: 48px;
  }
  /* Separate cards with space between them, so nothing shows through while they move. */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .service {
    position: relative;
    overflow: hidden;
    min-height: 264px;
    background: rgba(20, 18, 16, .88);
    border: 1px solid var(--line);
    padding: 30px 30px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    /* opacity and transform are listed so the scroll reveal eases too */
    transition: transform 420ms cubic-bezier(.2, .7, .2, 1), opacity 600ms ease,
      border-color 260ms ease, background 260ms ease;
  }
  /* a soft light that follows the pointer across the card (--mx/--my set by the script below) */
  .service::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 0%), rgba(182, 147, 245, .16), transparent 70%);
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .service > * { position: relative; }
  .service:hover { transform: translateY(-6px); border-color: var(--plasma-tint); background: rgba(30, 27, 24, .94); }
  .service:hover::before { opacity: 1; }
  .service-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .service .num {
    font-size: 30px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--rec);
    font-weight: 400;
  }
  .service .num.research-label { font-size: 10px; line-height: inherit; }
  .service h3 {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }
  .service p {
    color: var(--paper-muted);
    font-size: 14px;
    line-height: 1.75;
  }
  .service-more {
    margin-top: auto;
    padding-top: 10px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper-faint);
    transition: color 220ms ease, transform 220ms ease;
  }
  .service:hover .service-more {
    color: var(--rec);
    transform: translateX(3px);
  }

  /* research / "more to come" teaser card */
  /* the teaser fills whatever is left of its row */
  .service--research { min-height: 0; }
  .service--research:nth-child(3n + 1) { grid-column: 1 / -1; }
  .service--research:nth-child(3n + 2) { grid-column: span 2; }
  .service--research {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0,
        transparent 9px,
        rgba(247, 243, 233, 0.012) 9px,
        rgba(247, 243, 233, 0.012) 10px
      ),
      rgba(20, 18, 16, .88);
  }
  .research-label {
    display: inline-flex;
    align-items: center;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .research-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rec);
    margin-right: 8px;
    animation: research-pulse 1.8s ease-in-out infinite;
  }
  @keyframes research-pulse {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50%      { opacity: 1; transform: scale(1); }
  }

  /* ==================== CONTACT ==================== */
  .contact {
    text-align: center;
    padding: 76px 24px 96px;
    border-top: 1px solid var(--line);
  }
  .contact h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.015em;
    font-weight: 500;
    margin-bottom: 24px;
  }
  .contact p {
    color: var(--paper-muted);
    max-width: 500px;
    margin: 0 auto 40px;
    font-size: 14px;
    line-height: 1.75;
  }
  .contact-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
  .contact .book {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    border: 1px solid var(--paper);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: transform 200ms ease, background 200ms ease;
  }
  .contact .book:hover { transform: translateY(-2px); background: var(--plasma-tint); border-color: var(--plasma-tint); }
  .contact .book .arrow {
    opacity: 0.7;
    transition: transform 200ms ease;
  }
  .contact .book:hover .arrow { transform: translateX(3px); }
  .contact a.mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--paper);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    transition: border-color 200ms ease, background 200ms ease;
  }
  .contact a.mail:hover {
    border-color: var(--paper-muted);
    background: var(--ink-lift);
  }
  .contact a.mail .arrow {
    opacity: 0.6;
    transition: transform 200ms ease;
  }
  .contact a.mail:hover .arrow { transform: translateX(3px); }

  @media (max-width: 1080px) {
    .service-grid { grid-template-columns: repeat(2, 1fr); }
    .service--research:nth-child(n) { grid-column: auto; }
    .service--research:nth-child(odd) { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .services { padding: 60px 24px; }
    .service-grid { grid-template-columns: 1fr; }
    .service--research:nth-child(n) { grid-column: auto; }
    .service { padding: 28px 26px; min-height: 0; }
  }
</style>
