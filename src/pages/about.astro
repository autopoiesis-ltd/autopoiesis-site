---
import Base from '../layouts/Base.astro';
import AffiliationBar from '../components/AffiliationBar.astro';
import FieldScene from '../components/FieldScene.astro';
---

<Base
  title="Autopoiesis — about"
  description="About Autopoiesis — self-adaptive security for agentic systems."
  active="about"
>
  <FieldScene variant="membrane" />

  <section class="about field-scrim">
    <div class="eyebrow">about</div>
    <h1>We build and break agentic systems.</h1>

    <p class="lede">
      Autopoiesis is a research lab focused on secure autonomous AI agent enablement.
    </p>

    <p>
      We red-team agents and AI research environments to uncover weaknesses and design secure architectures
      to contain cybersecurity risks. Our work sits at the intersection of AI safety, secure systems engineering and applied research engineering.
    </p>

    <h2>Our approach</h2>
    <p>
      <em>Autopoiesis</em> describes a system that produces and maintains itself.
      We take the same approach to security as we build systems that can test continuously, contain failures,
      and adapt defences as systems and threats evolve. The end-goal is to make this an autonomous process.
    </p>
    <p>
      We take a formal approach to the design of every system, using applied category theory and formal grammars
      to specify how its components compose before anything is built.
    </p>

    <h2>Work with us</h2>
    <p>
      Building an agentic system?
      <a href="mailto:info@autopoiesis.uk"> Get in touch</a>.
    </p>
  </section>

  <!-- full-width strip, directly above the footer -->
  <AffiliationBar />
</Base>

<style>
  .about {
    max-width: 780px;
    margin: 0 auto;
    padding: 140px 40px 100px;
  }
  .about .eyebrow { margin-bottom: 24px; }
  .about h1 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 500;
    margin-bottom: 40px;
  }
  .about p {
    color: var(--paper-dim);
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 24px;
  }
  .about p.lede {
    color: var(--paper);
    font-size: 17px;
  }
  .about p a { color: var(--paper); }
  .about h2 {
    font-size: 13px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--rec);
    font-weight: 500;
    margin: 44px 0 20px;
  }

  @media (max-width: 600px) {
    .about { padding: 116px 24px 80px; }
  }
</style>
