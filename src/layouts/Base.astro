---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  active?: 'services' | 'about' | null;
}

const {
  title,
  description = 'Self-adaptive security for agentic systems.',
  active = null,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0C0D" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/autopoiesis-logo.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="crt-scanlines" aria-hidden="true"></div>

    <Nav active={active} />

    <slot />

    <Footer />

    <script>
      import '../scripts/effects.js';
    </script>
  </body>
</html>
